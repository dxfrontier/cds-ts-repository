{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "rootDir": "./",
    // @sap/cds 10 no longer wires its types automatically (no @types/sap__cds symlink);
    // load the global cds.ql APIs (SELECT, INSERT, ...) and the '@sap/cds' module types explicitly.
    "types": ["@cap-js/cds-types", "node"]
  },
  "include": ["./@dispatcher"]
}
